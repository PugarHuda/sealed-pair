# Copy to .env.local and fill in. .env.local is gitignored.

# Tatum API keys — one per network. Get them free at https://dashboard.tatum.io
# Server-only. Never expose with NEXT_PUBLIC_ prefix.
TATUM_API_KEY_MAINNET=t-XXXXXXXX-XXXXXXXX
TATUM_API_KEY_TESTNET=t-XXXXXXXX-XXXXXXXX
TATUM_API_KEY_DEVNET=t-XXXXXXXX-XXXXXXXX

# Network the server-side API routes default to. Overridable per request
# via ?network= query param on /api/sui, /api/health, etc.
SUI_NETWORK=mainnet

# Move package id (Sui devnet) — output of scripts/deploy-move.ps1.
# Required: without this, packageStatus().configured is false and the
# RFQ board never polls real events.
NEXT_PUBLIC_SEALED_PAIR_PACKAGE_ID=0x73d1acdda1d468d49e340023e7c3cc578466327dfa6109d93c5ce767640c99eb

# Which Sui network the deployed Move package lives on. Drives:
#   - Event polling on /app
#   - dApp Kit wallet provider's defaultNetwork
#   - SuiScan deep-link host
# MUST match the network the package above was deployed to.
NEXT_PUBLIC_SUI_NETWORK_FOR_EVENTS=devnet
